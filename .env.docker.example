# Copy to .env before `docker compose up`.
APP_NAME=Mnemon
APP_ENV=production
# Leave blank to have the entrypoint generate a key and persist it in the
# storage volume on first boot. Set it explicitly to pin the key yourself
# (e.g. to migrate an existing deployment's key onto this host).
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

# Set to a hostname you control to get automatic HTTPS from Let's Encrypt.
# Leave blank to serve plain HTTP on localhost:8080 for local trial.
# Running behind a separate TLS-terminating reverse proxy is NOT YET
# SUPPORTED — Mnemon does not process X-Forwarded-* headers, so OAuth
# discovery and asset URLs would still be advertised as http:// behind one.
# Use DOMAIN above to get HTTPS directly from this stack instead.
DOMAIN=

# Setting DOMAIN above REQUIRES both of these to be public binds — Let's
# Encrypt validates over port 80 and serves over 443. Leave them at their
# defaults for a local trial; a DOMAIN with loopback binds will fail
# certificate issuance.
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443

LOG_CHANNEL=stderr
LOG_LEVEL=info

# APP_TIMEZONE is what the scheduler actually obeys: every command in
# routes/console.php declares config('app.timezone'), so the early-morning
# maintenance runs early in THIS timezone rather than at a hard-coded UTC
# offset. Change it if you want maintenance to run in your local early morning.
APP_TIMEZONE=UTC

# TZ only sets the container's OS clock, which affects shell tools and
# non-PHP log timestamps. Laravel overrides PHP's timezone from APP_TIMEZONE
# regardless, so setting TZ alone will NOT move the schedule. Keep it matching
# APP_TIMEZONE so container logs and application times agree.
TZ=UTC

# Contact-form submissions on the landing page are always recorded in the
# database (ContactSubmission). Mail is written to the log by default — set
# a real mailer (e.g. MAIL_MAILER=resend, resend/resend-laravel is already a
# dependency) plus MAIL_FROM_ADDRESS, RESEND_API_KEY, and MNEMON_CONTACT_TO
# below to additionally get an email notification.
MAIL_MAILER=log

# Required if you set MAIL_MAILER=resend (or any real mailer): config/mail.php
# defaults the from-address to hello@example.com, which Resend and most
# providers reject as an unverified sender.
MAIL_FROM_ADDRESS=

# Required if you set MAIL_MAILER=resend. Get one from resend.com.
RESEND_API_KEY=

# Blank means the contact form only stores submissions — no email is sent.
# Set this to an address you own to also get notified.
MNEMON_CONTACT_TO=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mnemon
DB_USERNAME=mnemon
# Fixed the moment the `pgdata` volume is first initialised — Postgres only
# reads this on an EMPTY data directory. Changing it later and restarting
# does NOT change the role's password: the app crash-loops with "password
# authentication failed for user "mnemon"" while the db healthcheck
# (pg_isready, which performs no authentication) stays green. Change it
# before first boot, not after. To change it later: either run
# `ALTER ROLE mnemon WITH PASSWORD '...'` inside the db container and update
# this value to match, or `docker compose down -v` to start over (destroys
# all data). See docs/USERGUIDE.md.
DB_PASSWORD=change-me-before-you-deploy

# No embeddings by default: works with no account and no spend. Set to
# "openai" and supply OPENAI_API_KEY for semantic search.
MNEMON_EMBEDDING_DRIVER=none
OPENAI_API_KEY=

# Nothing dispatches jobs today. sync means a future dispatch() fails loudly
# rather than rotting unclaimed in the jobs table.
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
CACHE_STORE=database
