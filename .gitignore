*.log
.DS_Store
# Ignore every .env variant by default and allow the committed templates back
# in explicitly. An enumerated list let .env.bench through while it held a live
# OpenAI key — a `git add -A` away from publishing it.
.env*
!.env.example
!.env.docker.example
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/admin-password.txt
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Benchmark data and output — setup.sh re-downloads the dataset on demand
/benchmark/data/
/benchmark/results/
/benchmark/results-*/
/benchmark/state/
__pycache__/
*.pyc

# Generated at runtime by mnemon-capture.sh from an inline heredoc. Committing
# it would shadow the heredoc permanently, since the lazy write is guarded by
# [ ! -x "$worker" ] — edits to the source would then never take effect.
resources/hooks/claude-code/lib/digest-worker.sh
